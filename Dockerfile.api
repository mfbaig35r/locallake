FROM python:3.12-slim

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Workspace manifests (for dep resolution)
COPY pyproject.toml ./
COPY uv.lock* ./
COPY apps/api/pyproject.toml ./apps/api/
COPY apps/worker/pyproject.toml ./apps/worker/
COPY packages/locallake/pyproject.toml ./packages/locallake/
COPY packages/locallake_core/pyproject.toml ./packages/locallake_core/

# Source
COPY apps/api/src ./apps/api/src/
COPY packages/locallake_core/src ./packages/locallake_core/src/
COPY packages/locallake_core/alembic ./packages/locallake_core/alembic/
COPY packages/locallake_core/alembic.ini ./packages/locallake_core/
COPY packages/locallake/src ./packages/locallake/src/

RUN uv sync --package locallake-api --no-dev

EXPOSE 8000
CMD ["uv", "run", "--package", "locallake-api", "uvicorn", "locallake_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
